# Copy to .env and adjust. .env is gitignored.
POSTGRES_USER=civic
POSTGRES_PASSWORD=civic
POSTGRES_DB=civic
POSTGRES_PORT=5433
POSTGRES_TEST_PORT=55433
KAFKA_PORT=19092
REDIS_PORT=16379

# SMS login codes (Africa's Talking). Leave the key empty to log codes to
# .dev/logs/api.log instead. Username "sandbox" uses the AT simulator.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# true: the request waits for the carrier; false: sent in the background
FORCE_SEND_SMS_SYNC=true
