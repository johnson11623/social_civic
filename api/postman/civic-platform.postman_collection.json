{
  "info": {
    "name": "Kenyan Civic Platform API",
    "description": "Local API checks. Start the API with `make run-api` (http://localhost:8090), then run the collection top to bottom: Search saves a real ward code, Register uses it with a fresh random national ID, and the negative cases reuse that ID. Login needs the SMS code: in development it is printed to the API log (\"DEV SMS (not sent)\"); set the `otp` variable to run the Login request. Registration requires a Kenyan mobile number.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "wardCode",
      "value": "551"
    },
    {
      "key": "nationalId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "firstRefreshToken",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "pm.test('has X-Request-ID', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.match(/^req_/));"
            ]
          }
        }
      ]
    },
    {
      "name": "Boundary",
      "item": [
        {
          "name": "Search ward (with typo)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/boundary/search?q=kiamwngi&level=ward&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "boundary",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "kiamwngi",
                  "description": "Name as typed: case, apostrophes, spacing and small typos are tolerated"
                },
                {
                  "key": "level",
                  "value": "ward",
                  "description": "county | constituency | ward (optional)"
                },
                {
                  "key": "limit",
                  "value": "5",
                  "description": "1–50, default 10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "pm.test('finds Kiamwangi despite the typo', () => {",
                  "  pm.expect(items[0].label).to.eql('Kiamwangi, Gatundu South, Kiambu');",
                  "  pm.expect(items[0].level).to.eql('ward');",
                  "});",
                  "pm.collectionVariables.set('wardCode', items[0].code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search across levels",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/boundary/search?q=ziwa ngombe"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('first hit is Ziwa la Ng\\'ombe (0017)', () => {",
                  "  const first = pm.response.json().items[0];",
                  "  pm.expect(first.iebc_code).to.eql('0017');",
                  "  pm.expect(first.county.name).to.eql('Mombasa');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search too short (422)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/boundary/search?q=a"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "pm.test('problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tree",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/boundary/tree"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('47 counties, 290 constituencies, 1450 wards', () => {",
                  "  const c = body.counties;",
                  "  const k = c.flatMap(x => x.children);",
                  "  const w = k.flatMap(x => x.children);",
                  "  pm.expect([c.length, k.length, w.length]).to.eql([47, 290, 1450]);",
                  "});",
                  "pm.test('cacheable', () => pm.expect(pm.response.headers.get('ETag')).to.eql('\"' + body.version + '\"'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"{{nationalId}}\",\n  \"phone\": \"0712 345 678\",\n  \"display_name\": \"Wanjiku M.\",\n  \"preferred_lang\": \"sw\",\n  \"ward_id\": {{wardCode}},\n  \"consent_version\": \"2026-01\",\n  \"consent_granted\": true\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Fresh 8-digit ID each run so Register returns 201 instead of 409.",
                  "pm.collectionVariables.set('nationalId', String(Math.floor(10000000 + Math.random() * 90000000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('joins four groups', () => pm.expect(body.groups.map(g => g.level)).to.eql([1, 2, 3, 4]));",
                  "pm.test('ward matches the searched code', () => pm.expect(body.groups[0].id).to.eql(Number(pm.collectionVariables.get('wardCode'))));",
                  "pm.test('returns tokens', () => {",
                  "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.expires_in).to.eql(900);",
                  "});",
                  "pm.test('never echoes the national ID', () => pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('nationalId')));",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "pm.collectionVariables.set('refreshToken', body.refresh_token);",
                  "pm.collectionVariables.set('firstRefreshToken', body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate ID (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"{{nationalId}}\",\n  \"phone\": \"0712 345 678\",\n  \"display_name\": \"Someone Else\",\n  \"ward_id\": {{wardCode}},\n  \"consent_version\": \"2026-01\",\n  \"consent_granted\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));",
                  "pm.test('code id_already_registered', () => pm.expect(pm.response.json().code).to.eql('id_already_registered'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register without consent (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"12345670\",\n  \"phone\": \"0712 345 678\",\n  \"display_name\": \"No Consent\",\n  \"ward_id\": {{wardCode}},\n  \"consent_version\": \"2026-01\",\n  \"consent_granted\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "pm.test('code consent_required', () => pm.expect(pm.response.json().code).to.eql('consent_required'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register unknown ward (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"12345671\",\n  \"phone\": \"0712 345 678\",\n  \"display_name\": \"Nowhere\",\n  \"ward_id\": 1451,\n  \"consent_version\": \"2026-01\",\n  \"consent_granted\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "pm.test('code invalid_unit', () => pm.expect(pm.response.json().code).to.eql('invalid_unit'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register invalid national ID (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"1234567\",\n  \"phone\": \"0712 345 678\",\n  \"display_name\": \"Short ID\",\n  \"ward_id\": {{wardCode}},\n  \"consent_version\": \"2026-01\",\n  \"consent_granted\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('code invalid_id', () => pm.expect(pm.response.json().code).to.eql('invalid_id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Request login code (202)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"{{nationalId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('expires in 5 minutes', () => pm.expect(pm.response.json().expires_in).to.eql(300));",
                  "// In development the code is written to the API log: look for \"DEV SMS (not sent)\"."
                ]
              }
            }
          ]
        },
        {
          "name": "Request code for unknown ID (same 202)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"99999999\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202, identical to a registered ID', () => {",
                  "  pm.response.to.have.status(202);",
                  "  pm.expect(pm.response.json()).to.eql({otp_requested: true, expires_in: 300});",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong code (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"{{nationalId}}\",\n  \"otp\": \"000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 invalid_credentials', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().code).to.eql('invalid_credentials');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (paste code from API log)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"{{nationalId}}\",\n  \"otp\": \"{{otp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Manual step: set the collection variable `otp` to the code from the API log, then Send.",
                  "if (!pm.collectionVariables.get('otp')) { pm.test('skipped: set {{otp}} first', () => {}); return; }",
                  "pm.test('200 with tokens', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().access_token);",
                  "pm.collectionVariables.set('refreshToken', pm.response.json().refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh (rotates tokens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{firstRefreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with new tokens', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('refresh token rotated', () => pm.expect(body.refresh_token).to.not.eql(pm.collectionVariables.get('firstRefreshToken')));",
                  "pm.test('not cacheable', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "pm.collectionVariables.set('refreshToken', body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh with rotated token (401 reuse)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{firstRefreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 token_reuse_detected', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().code).to.eql('token_reuse_detected');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh after reuse (401 revoked)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 token_revoked: reuse signed out every session', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().code).to.eql('token_revoked');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
