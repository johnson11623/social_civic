+type StatusSchemas = ReadonlyMap<number, { readonly ast: Option.Option<AST.AST> }>;
+
+/**
+ * Decode the handler's response the way HttpApiClient does over HTTP: a
+ * success status through its success schema (the caller gets the decoded
+ * Type, e.g. camelCase keys from fromKey), an error status through its
+ * error schema as a typed failure. Without this, SSR callers would receive
+ * the encoded wire body, and errors would arrive as successes.
+ */
+function decodeResponse(
+  response: unknown,
+  body: unknown,
+  successes: StatusSchemas,
+  errors: StatusSchemas,
+): Effect.Effect<unknown, unknown> {
+  if (!HttpServerResponse.isServerResponse(response)) return Effect.succeed(body);
+  const status = response.status;
+  const ok = status >= 200 && status < 300;
+  const entry = (ok ? successes : errors).get(status);
+  const ast = entry ? Option.getOrUndefined(entry.ast) : undefined;
+  if (!ast) {
+    return ok ? Effect.succeed(body) : Effect.die(new Error(`SSR call failed with undeclared status ${status}`));
+  }
+  const decoded = Schema.decodeUnknown(Schema.make(ast))(body);
+  return ok ? Effect.orDie(decoded) : Effect.flatMap(Effect.orDie(decoded), Effect.fail);
+}
